{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and stats",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "full_name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "teacher", "student"] },
        "grade": { "type": "string" },
        "points": { "type": "number" },
        "coins": { "type": "number" }
      },
      "required": ["id", "username", "full_name", "role"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Educational subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" }
      },
      "required": ["id", "name", "grade"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Educational lesson",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject_id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["video", "pdf", "text"] },
        "url": { "type": "string" }
      },
      "required": ["id", "subject_id", "title", "type"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Subject exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject_id": { "type": "string" },
        "title": { "type": "string" },
        "duration": { "type": "number" }
      },
      "required": ["id", "subject_id", "title"]
    },
    "Question": {
      "title": "Question",
      "description": "Exam question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exam_id": { "type": "string" },
        "question_text": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correct_answer": { "type": "string" },
        "type": { "type": "string", "enum": ["mcq", "tf", "short"] }
      },
      "required": ["id", "exam_id", "question_text", "correct_answer", "type"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Subject documents"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Lesson documents"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "Exam documents"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Question documents"
    }
  }
}
